def deleteAtStart(head):
    if head is None:
        print("Error: singly inked list is empty")
        return None
    new_head=head.next
    del head
    return new_head

def deleteAtEnd(head):
    if head is None:
        print("Error: singly inked list is empty")
        return None
    if head.next is None:
        return None

    current = head

    while current.next.next is not None:
        current = current.next

    current.next = None
    return head
    
def search(head, key):
    temp = head
    pos = 1

    while temp:
        if temp.data == key:
            print("Element Found at Position", pos)
            return

        temp = temp.next
        pos += 1

