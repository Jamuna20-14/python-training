25)Explain the role of prev and next pointers.
class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None   # points to previous node
        self.next = None   # points to next node
class DoublyLinkedList:
    def __init__(self):
        self.head = None
    def append(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
            return
        temp = self.head
        while temp.next:
            temp = temp.next
        temp.next = new_node   
        new_node.prev = temp    
    def display_forward(self):
        print("Forward Traversal:")
        temp = self.head
        last = None
        while temp:
            print(temp.data, end=" <-> ")
            last = temp
            temp = temp.next
        print("NULL")
        return last  # return last node
    def display_backward(self, tail):
        print("Backward Traversal:")
        temp = tail
        while temp:
            print(temp.data, end=" <-> ")
            temp = temp.prev
        print("NULL")
