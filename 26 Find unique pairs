# Find unique pairs

d1=(7,2)
d2=(8,2)
res=[]
for i in range(len(d1)):
    for j in range(len(d2)):
        if [d1[i],d2[j]] not in res:
            res.append([d1[i],d2[j]])
        if [d1[j],d2[i]] not in res:
            res.append([d1[j],d2[i]])
        if [d2[i],d1[j]] not in res:
            res.append([d2[i],d1[j]])
print(res)				

