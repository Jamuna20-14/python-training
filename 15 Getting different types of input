# Getting different types of input

integer = int(input("Enter an integer: "))
print(integer)

f = float(input("Enter float value: "))
print(f)

s = input("Enter a string: ")
print(s)

value = input("Enter True or False: ")
flag = value.lower() == "true"
print(flag)

num = complex(input("Enter a complex number (example: 2+3j): "))
print(num)

numbers = list(map(int, input("Enter numbers separated by space: ").split()))
print(numbers)

